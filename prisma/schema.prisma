// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum CardStatus {
  ACTIVE
  INACTIVE
}

// ─── Models ────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  fullName       String
  whatsappNumber String?
  avatarUrl      String?  @db.LongText
  role           Role     @default(USER)
  isActive       Boolean  @default(true)

  // Self-relation: siapa yang membuat akun ini (Super Admin buat Admin, Admin buat User/Outlet)
  createdById  String?
  createdBy    User?    @relation("CreatedUsers", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]   @relation("CreatedUsers")

  // Hierarki Super Admin & Granular Permission
  isSuperAdminMaster      Boolean @default(false) // True untuk Super Admin 1 (Master)
  canEditLandingPage      Boolean @default(false) // Izin khusus Super Admin 2 untuk edit teks & WA Landing Page
  canManagePrintTemplates Boolean @default(false) // Izin khusus Super Admin 2 untuk kelola template cetak multi-ukuran
  canDeleteCards          Boolean @default(false) // Izin khusus Super Admin 2 untuk menghapus kartu
  canViewAnalytics        Boolean @default(false) // Izin khusus Super Admin 2 untuk melihat data pengunjung & analitik web

  // Pengaturan & Status Modul Reseller
  isResellerUnlocked      Boolean @default(true) // True jika akun sudah dibuka/bayar modul
  resellerVipRewardsClaimed Int   @default(0)    // Total reward diskon kartu dari outlet VIP yang sudah terpakai

  outlet Outlet?

  // Kartu QR yang dialokasikan ke Admin ini
  assignedCards QrCard[] @relation("AssignedCards")

  activityLogs           ActivityLog[]
  invoices               Invoice[]
  pushSubscriptions      PushSubscription[]
  resellerModulePayments ResellerModulePayment[]
  resellerOrders         ResellerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([role])
  @@index([isActive])
  @@index([role, createdAt])
  @@index([createdById, role])
  @@index([role, isSuperAdminMaster])
  @@map("users")
}

model SiteSetting {
  id                String   @id @default("default")
  appVersion        String   @default("V 1.1.2")
  whatsappNumber    String   @default("6281234567890")
  globalFallbackUrl String   @default("http://localhost:3000")
  heroBadge         String   @default("🔥 Solusi Cerdas Ulasan Bintang 5 Google Bisnis")
  heroHeadline      String   @default("Dapatkan Ratusan Ulasan Bintang 5 Dengan Sekali Tap")
  heroSubheadline   String   @default("Ubah setiap pelanggan yang puas menjadi ulasan bintang 5 resmi di Google Maps secara instan menggunakan Kartu Dynamic QR & Smart NFC.")
  ctaPrimaryText    String   @default("Pesan Kartu & Konsultasi WhatsApp")
  ctaSecondaryText  String   @default("Coba Scan Demo (c-001)")
  ctaSecondaryUrl   String   @default("/c/c-001")
  step1Title        String   @default("Letakkan di Meja / Kasir")
  step1Desc         String   @default("Pasang kartu akrilik atau standee QR pintar di meja makan, resepsionis, atau meja kasir saat pelanggan membayar.")
  step2Title        String   @default("Pelanggan Scan / Tap")
  step2Desc         String   @default("Pelanggan cukup mengarahkan kamera smartphone atau mendekatkan HP tanpa perlu mengetik atau mencari nama outlet di Google Maps.")
  step3Title        String   @default("Pop-up Review Langsung Terbuka")
  step3Desc         String   @default("Halaman rating bintang 5 Google resmi langsung muncul seketika di layar HP pelanggan, siap dikirim dalam 5 detik!")
  footerText         String   @default("Smart QR Review Platform. Seluruh hak cipta dilindungi.")
  seoTitle           String?  @db.Text
  seoDescription     String?  @db.Text
  dashboardLogoUrl   String?  @db.LongText
  landingPageLogoUrl String?  @db.LongText
  faviconUrl         String?  @db.LongText
  printTemplates     String?  @db.LongText
  visitorCount       Int      @default(0)

  // Membership & Pricing Settings (Dikelola Super Admin)
  membershipPrice          Int      @default(45000)
  membershipBankName       String   @default("BCA")
  membershipAccountNumber  String   @default("0885172288")
  membershipAccountName    String   @default("Smart QR Review")
  membershipNotes          String?  @db.Text
  membershipTrialNotice    String?  @db.Text

  // Midtrans Payment Gateway Configuration
  midtransServerKey        String?  @db.Text
  midtransClientKey        String?  @db.Text
  midtransIsProduction     Boolean  @default(false)
  trialDurationDays        Int      @default(30)
  autoVipTrialOnActivation Boolean  @default(true)

  // Reseller Module & Pricing Settings
  resellerModulePrice        Int      @default(150000)
  resellerVipDiscountPerCard Int      @default(5000)
  resellerCardBasePrice      Int      @default(25000)
  resellerShippingFee        Int      @default(20000) // Biaya Ongkir & Packing Tetap (Rp 20.000)
  resellerModuleTitle        String   @default("Starter Kit & Modul Resmi Kemitraan Smart QR")
  resellerModuleDesc         String?  @db.Text
  resellerModulePdfUrl       String?  @db.LongText
  resellerBankName           String   @default("BNI")
  resellerAccountNumber      String   @default("1234567890")
  resellerAccountName        String   @default("Smart QR Review")

  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

model Outlet {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  googleReviewUrl String   @db.Text

  // Status Member Premium
  isMember            Boolean   @default(false)
  membershipStartedAt DateTime?
  membershipExpiresAt DateTime?
  customVipPrice      Int?      // Harga VIP khusus untuk outlet ini (override harga master jika diisi)

  // Fitur Eksklusif Member VIP & Filter Ulasan Cerdas
  enableSmartFilter   Boolean   @default(true)  // Switch ON/OFF filter bintang (1-3 ke WA, 4-5 ke Google)
  allowSmartFilter    Boolean   @default(false) // Izin khusus dari Admin untuk outlet reguler non-VIP
  soundEffect         String    @default("BELL_DOUBLE") // BELL_DOUBLE | CHA_CHING | LUXURY_CHIME | CELEBRATION
  customGreetingText  String?   @db.Text
  staffPairingToken   String?   @unique

  qrCards            QrCard[]
  feedbacks          CustomerFeedback[]
  pushSubscriptions  PushSubscription[]
  membershipPayments MembershipPayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isMember])
  @@index([isMember, membershipExpiresAt])
  @@index([createdAt])
  @@index([name])
  @@map("outlets")
}

model CustomerFeedback {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cardCode     String?
  rating       Int
  customerName String?
  phone        String?
  message      String   @db.Text
  isResolved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([outletId])
  @@index([createdAt])
  @@index([outletId, rating])
  @@index([outletId, createdAt])
  @@map("customer_feedbacks")
}

model QrCard {
  code            String     @id
  outletId        String?
  outlet          Outlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)
  status          CardStatus @default(ACTIVE)
  scanCount       Int        @default(0)
  fallbackUrl     String     @default("http://localhost:3000")

  assignedAdminId String?
  assignedAdmin   User?      @relation("AssignedCards", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assignedAdminId])
  @@index([outletId])
  @@index([status])
  @@index([outletId, status])
  @@index([assignedAdminId, status])
  @@index([createdAt])
  @@map("qr_cards")
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String
  userRole     Role
  action       String   // e.g. "AUTH_LOGIN", "REGISTER_OUTLET", "ASSIGN_CARD", "TOGGLE_CARD_STATUS", "UPDATE_OUTLET", "DELETE_OUTLET", "GENERATE_BATCH_CARDS", "CREATE_ADMIN", etc.
  title        String
  description  String   @db.Text
  targetId     String?
  targetName   String?
  outletId     String?
  adminId      String?
  superAdminId String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([outletId])
  @@index([adminId])
  @@index([superAdminId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([outletId, createdAt])
  @@map("activity_logs")
}

model DailyVisitor {
  id      String @id @default(cuid())
  date    String @unique // Format: YYYY-MM-DD
  visits  Int    @default(0)

  @@map("daily_visitors")
}

model DatabaseBackup {
  id            String   @id @default(cuid())
  filename      String   @unique
  sizeBytes     Int
  formattedSize String
  content       String?  @db.LongText
  isAuto        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("database_backups")
}

model Promo {
  id            String    @id @default(cuid())
  label         String    // Judul promo, contoh: "Promo Spesial September"
  description   String?   @db.Text // Deskripsi singkat opsional
  originalPrice String    // Harga asli (string bebas, contoh: "50", "500.000")
  discountPrice String    // Harga diskon (string bebas, contoh: "35", "350.000")
  priceUnit     String    @default("rb") // Satuan tampil, contoh: "rb", "ribu", "K", ""
  expiredAt     DateTime? // Null = promo selamanya
  isActive      Boolean   @default(true)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@map("promos")
}

model ProductPhoto {
  id        String   @id @default(cuid())
  imageData String   @db.LongText // base64 — hapus row = hapus foto bersih dari DB
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_photos")
}

model Invoice {
  id                String   @id @default(cuid())
  invoiceNumber     String   @unique
  orderDate         String   // Format: YYYY-MM-DD
  customerName      String
  customerPhone     String?
  itemsJson         String   @db.LongText // JSON: [{ id, name, qty, price }]
  subtotal          Int      @default(0)
  discount          Int      @default(0)
  grandTotal        Int      @default(0)
  paymentStatus     String   @default("LUNAS") // "LUNAS" | "DP"
  downPaymentAmount Int      @default(0)
  remainingAmount   Int      @default(0)
  paymentMethod     String?
  notes             String?  @db.Text
  bankName          String?  @default("BCA")
  accountNumber     String?  @default("0885172288")
  accountName       String?  @default("Smart Review")
  accountNotes      String?  @default("Konfirmasi transfer via WhatsApp pengelola.")
  customLogoUrl     String?  @db.LongText

  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdById])
  @@index([invoiceNumber])
  @@index([customerName])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("invoices")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String   @db.Text
  outletId  String?
  userId    String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet    Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([userId])
  @@map("push_subscriptions")
}

model MembershipPayment {
  id                    String    @id @default(cuid())
  outletId              String
  outlet                Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  amount                Int
  paymentType           String    @default("MIDTRANS_QRIS") // "MIDTRANS_QRIS" | "MANUAL"
  proofImageUrl         String?   @db.LongText
  status                String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "EXPIRED"
  midtransOrderId       String?   @unique
  midtransTransactionId String?
  qrisUrl               String?   @db.Text
  snapToken             String?   @db.Text
  senderName            String?
  senderNotes           String?   @db.Text
  adminNotes            String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([outletId])
  @@index([status])
  @@index([midtransOrderId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([outletId, status])
  @@map("membership_payments")
}

model ResellerModulePayment {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                Int
  paymentType           String    @default("MIDTRANS_QRIS") // "MIDTRANS_QRIS" | "MANUAL"
  proofImageUrl         String?   @db.LongText
  status                String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  midtransOrderId       String?   @unique
  midtransTransactionId String?
  qrisUrl               String?   @db.Text
  snapToken             String?   @db.Text
  senderName            String?
  senderNotes           String?   @db.Text
  adminNotes            String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([midtransOrderId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("reseller_module_payments")
}

model ResellerProduct {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?  @db.LongText
  price       Int      @default(25000)
  minOrder    Int      @default(8)
  unit        String   @default("pcs")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  orderItems  ResellerOrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("reseller_products")
}

model ResellerOrder {
  id                    String              @id @default(cuid())
  orderNumber           String              @unique
  adminId               String?
  admin                 User?               @relation(fields: [adminId], references: [id], onDelete: SetNull)
  customerName          String
  customerPhone         String
  customerEmail         String
  shippingAddress       String?             @db.Text
  notes                 String?             @db.Text
  paymentMethod         String              @default("MANUAL_BANK_BNI") // "MIDTRANS_QRIS" | "MANUAL_BANK_BNI"
  paymentStatus         String              @default("PENDING") // "PENDING" | "PAID" | "REJECTED" | "CANCELLED"
  orderStatus           String              @default("PENDING") // "PENDING" | "PROCESSING" | "SHIPPED" | "COMPLETED" | "CANCELLED"
  totalQuantity         Int
  subtotal              Int
  discountAmount        Int                 @default(0)
  shippingFee           Int                 @default(20000)
  totalAmount           Int
  receiptImageUrl       String?             @db.LongText
  midtransSnapToken     String?             @db.Text
  midtransOrderId       String?             @unique
  midtransTransactionId String?
  items                 ResellerOrderItem[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([adminId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([midtransOrderId])
  @@index([createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("reseller_orders")
}

model ResellerOrderItem {
  id           String           @id @default(cuid())
  orderId      String
  order        ResellerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      ResellerProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productPrice Int
  quantity     Int
  subtotal     Int
  createdAt    DateTime         @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("reseller_order_items")
}

